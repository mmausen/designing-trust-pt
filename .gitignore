# ── participant data: never commit ──────────────────────────────────
# The collector writes real session data into logs/. Only the folder's
# own README and .gitignore are tracked (see logs/.gitignore).
logs/**/*.json
logs/**/*.jsonl
logs/**/*.tmp

# ── dependencies / build ────────────────────────────────────────────
node_modules/
package-lock.json

# ── OS / editor noise ───────────────────────────────────────────────
.DS_Store
*.swp
*~

# ── the Cursor Gym ──────────────────────────────────────────────────
# moveMe/ is a separate project with its own .git — the sandbox the two
# cursor characters were tuned in (see cursors.json). Committing it here
# would add it as a gitlink, not as files.
moveMe/

# ── local tool state (machine-specific, not shared) ─────────────────
.claude/settings.local.json
